# Copy to .env.local and fill in. Never commit real values. Secrets must NEVER start with NEXT_PUBLIC_.
# Ask the tech lead for the DEV values. Never point local/preview at the production database.

# ── Supabase (Project Settings → API) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# Server-only. Admin panel, public chat links, account deletion. Bypasses RLS — handle with care.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ── Admin bootstrap ─────────────────────────────────────────────────────────────────
# Comma-separated emails that are always admins. More admins can be promoted from /admin/users.
ADMIN_EMAILS=you@example.com

# ── Site ────────────────────────────────────────────────────────────────────────────
# Public URL of this deployment (used for absolute links). Optional locally.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI & integrations (Phases 3–4) — not used yet ────────────────────────────────────
# GROQ_API_KEY=
# COMPOSIO_API_KEY=

# ── Background jobs (Phase 1) ───────────────────────────────────────────────────────
# Protects /api/v1/jobs/*; Vercel Cron sends it.
# CRON_SECRET=

# ── Observability (Phase 6) ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
