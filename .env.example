# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# Server-only. Powers the admin panel (list/ban/delete users). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Comma-separated emails that are always admins (bootstrap your first admin here).
# More admins can be promoted from /admin/users.
ADMIN_EMAILS=you@example.com
