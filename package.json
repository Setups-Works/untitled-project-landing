{
  "name": "untitled-project",
  "private": true,
  "version": "2.4.0",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@untitled/web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@untitled/web",
    "build:mobile": "turbo run build --filter=mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "node scripts/db/migrate.mjs",
    "docker:up": "docker compose --env-file .env.selfhost up -d",
    "docker:down": "docker compose --env-file .env.selfhost down",
    "test": "corepack pnpm --filter @untitled/web test",
    "test:watch": "corepack pnpm --filter @untitled/web test:watch",
    "test:db": "corepack pnpm --filter @untitled/web test:db",
    "test:e2e": "corepack pnpm --filter @untitled/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design": "node scripts/check-design.mjs",
    "check:design:all": "node scripts/check-design.mjs --all",
    "prepare": "node scripts/ensure-pnpm-shim.mjs && git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.7.0"
  }
}
