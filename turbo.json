{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "SMTP_URL",
        "MAIL_FROM",
        "AUTH_REQUIRE_EMAIL_VERIFICATION",
        "GROQ_API_KEY",
        "GROQ_MODEL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "NEXT_PUBLIC_SITE_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "ADMIN_EMAILS",
        "HOSTNAME",
        "NEXT_TELEMETRY_DISABLED",
        "WATCHPACK_POLLING"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": { "cache": false },
    "test:db": { "cache": false },
    "test:e2e": { "cache": false }
  }
}
