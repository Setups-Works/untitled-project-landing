# Copy to .env.selfhost (gitignored). Change every secret. Never commit real values.
# Generate a secret:  openssl rand -hex 24
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=untitled
REDIS_PASSWORD=change-me
S3_ACCESS_KEY=untitled
S3_SECRET_KEY=change-me

# Auth (Better Auth). BETTER_AUTH_URL is the public URL of the app.
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Continue with Google". Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that are always admins.
ADMIN_EMAILS=you@example.com
# Mail. Dev uses Mailpit (http://localhost:8025). In production use a real SMTP server, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=smtp://mailpit:1025
